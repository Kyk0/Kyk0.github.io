---
// A formatted citation with "copy citation" and a BibTeX toggle with its own copy button.
// Works without JS: the text is selectable and <details> opens natively.
import { bibtex, citation, SITE, SHOW_TODO, type Paper } from '../lib/util';
interface Props {
  pub: Paper;
  projectHref?: string; // link to the paper's project page
  showLinks?: boolean;
  compact?: boolean; // links + copy buttons only, for lists where the title is already shown
}
const { pub: p, projectHref, showLinks = true, compact = false } = Astro.props;
const bib = bibtex(p);
const cite = citation(p);
const links = [
  p.arxiv && { label: 'arXiv', url: `https://arxiv.org/abs/${p.arxiv}` },
  p.pdf && { label: 'pdf', url: p.pdf },
  p.code && { label: 'code', url: p.code },
  p.video && { label: 'video', url: p.video },
  projectHref && { label: 'project', url: projectHref },
].filter(Boolean) as { label: string; url: string }[];
---
<div class:list={['citation', { compact }]}>
  {!compact && <>
  <span class="pub-title">{p.title}</span>
  <span class="pub-authors">
    {p.authors.map((a, i) => (
      <>{a.includes(SITE.me) ? <strong>{a}</strong> : a}{i < p.authors.length - 1 ? ', ' : '.'}</>
    ))}
  </span>
  <span class="pub-venue"><em>{p.venue}</em>, {p.year}{p.status && <span class="meta"> · {p.status}</span>}</span>
  </>}
  <span class="pub-links meta">
    {showLinks && links.map((l) => <a href={l.url}>{l.label}</a>)}
    <button type="button" class="copy" data-copy={cite} hidden>copy citation</button>
    {bib ? (
      <details class="bib">
        <summary>BibTeX</summary>
        <pre><code>{bib}</code></pre>
        <button type="button" class="copy" data-copy={bib} hidden>copy BibTeX</button>
      </details>
    ) : (
      SHOW_TODO && <span class="todo">BibTeX: TODO</span>
    )}
  </span>
  {!compact && p.todo && SHOW_TODO && <span class="todo">TODO: {p.todo}</span>}
</div>
